# --- Database ---
DATABASE_URL=sqlite:///./recovery.db

# --- Fuzzy customer matching (see app/matching/resolver.py) ---
MATCH_THRESHOLD=72
MATCH_AMBIGUITY_GAP=5

# --- Twilio. WhatsApp is inbound-only (the Q&A bot) and needs no "from"
# config beyond the Sandbox itself. Voice is the final-step outbound call.
# Leave blank to run voice in log-only mode. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
TWILIO_WHATSAPP_FROM=

# --- Payment-received alert (app/notifications.py). One-off exception to
# "WhatsApp is inbound-only": when Razorpay confirms a payment, a WhatsApp
# message naming the amount and the invoice(s) cleared is sent to whoever
# last WhatsApp-queried that customer's report (Customer.last_whatsapp_
# query_from) — not a fixed number. This is only a fallback for a payment
# closing on an account nobody has queried yet. Leave blank to disable the
# fallback (payments still close out normally either way). ---
PAYMENT_NOTIFY_WHATSAPP_TO=

# --- Razorpay (test mode). Leave blank to use stub payment links. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI decision layer (app/decisions/decision_layer.py) — fully homegrown,
# no external API. Tunable weights, all optional (sensible defaults apply).
# Picks how far up the spoc -> manager -> skip_level chain to start/jump,
# and how many days to wait before the next escalation. ---
URGENCY_MANAGER_THRESHOLD=35
URGENCY_SKIP_LEVEL_THRESHOLD=60
URGENCY_RELIABILITY_BONUS_MAX=25
URGENCY_MATERIALITY_BONUS_MAX=10
URGENCY_TOUCH_BONUS_MAX=10
URGENCY_TOUCH_CAP_FOR_SCORING=5
URGENCY_BROKEN_PROMISE_BONUS_MAX=15
URGENCY_BROKEN_PROMISE_CAP_FOR_SCORING=3
URGENCY_MAX_WAIT_DAYS=5
URGENCY_MIN_WAIT_DAYS=1
LARGE_INVOICE_THRESHOLD=300000

# --- Email channel — the actual escalation channel (spoc/manager/skip_level).
# Leave blank to run in log-only mode. ---
SENDGRID_API_KEY=
EMAIL_FROM=collections@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Testing convenience — leave blank in a real deployment. When set, every
# escalation email is redirected here instead of the sheet's real
# spoc/manager/skip_level addresses, so you can watch the chain without
# emailing anyone real. The original intended recipient(s) are preserved in
# the subject line and in the portal's "Preview" panel. ---
TEST_EMAIL_OVERRIDE=

# --- Compliance / stopping rules ---
QUIET_HOURS_START=21:00
QUIET_HOURS_END=09:00
MAX_TOUCH_CAP=6

# --- Chatbot (app/chatbot/). Routes free text to existing, already-tested
# functions via Claude's tool-calling — it never computes a number or an
# escalation decision itself, only picks which function to call. Any tool
# with a real side effect (a Razorpay link, a real email) is never
# auto-executed; it's held pending until the person replies yes/no, checked
# deterministically in app/chatbot/agent.py, not left to the model's own
# judgment. Leave blank to disable — the /chat page will say so. ---
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-sonnet-5
